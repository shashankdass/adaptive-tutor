# Copy this to `.streamlit/secrets.toml` for local Groq testing, OR paste these
# keys into the "Secrets" box in Streamlit Community Cloud (App → Settings → Secrets).
#
# Get a free Groq API key at: https://console.groq.com/keys
#
# When GROQ_API_KEY is present, the app automatically uses Groq's hosted Llama 3
# instead of local Ollama — so it runs on a free cloud instance with no GPU.

GROQ_API_KEY = "gsk_your_key_here"

# Optional overrides:
# LLM_MODEL = "llama-3.1-8b-instant"   # any Groq-hosted model
# LLM_BACKEND = "groq"                  # force a backend ("groq" or "ollama")
